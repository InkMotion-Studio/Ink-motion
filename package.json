{
  "name": "inkmotion",
  "version": "2.0.0",
  "private": true,
  "description": "墨演 InkMotion — 纯前端古典中文风格视频生成器（V2.0：main 基线重建，离线逐笔 + 笔锋动态）",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor:hanzi": "node scripts/vendor-hanzi-data.mjs",
    "predev": "node scripts/vendor-hanzi-data.mjs",
    "prebuild": "node scripts/vendor-hanzi-data.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:all": "node e2e/all.mjs",
    "test:release": "node e2e/release-check.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "hanzi-writer": "^3.7.1",
    "hanzi-writer-data": "^2.0.1",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.2",
    "axe-core": "^4.14.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.64.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
