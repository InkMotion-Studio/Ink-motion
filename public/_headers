# N5.1 静态部署配置（纯前端，无服务端）
# V1-C5 更新：资产缓存命名空间升至 inkmotion-assets-v2，新增小篆字库资产（fonts/seal/*）。
# 策略：入口不缓存；内容哈希资源 immutable 长缓存；字库资产按版本命名空间发布，可安全长缓存。

/*    !/assets/*    !/textures/*   !/fonts/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/textures/*
  Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=2592000

# 小篆字库（版本化资产，随 inkmotion-assets-v2 命名空间整体升级）
/fonts/seal/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# SPA 回退（HashRouter 下非必需，保留以兼容未来 History 路由）
/*    /index.html   200

# 安全响应头
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
